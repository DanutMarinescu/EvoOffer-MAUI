<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EvoOffer.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="Ink">#101D31</Color>
            <Color x:Key="MutedInk">#50627C</Color>
            <Color x:Key="Accent">#147EF0</Color>
            <Color x:Key="PageBackground">#F7F9FC</Color>
            <Style TargetType="ContentPage">
                <Setter Property="BackgroundColor" Value="{StaticResource PageBackground}" />
            </Style>
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource Ink}" />
                <Setter Property="FontSize" Value="16" />
            </Style>
            <Style TargetType="Entry">
                <Setter Property="TextColor" Value="{StaticResource Ink}" />
                <Setter Property="PlaceholderColor" Value="#8491A3" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="FontSize" Value="17" />
            </Style>
            <Style TargetType="Editor">
                <Setter Property="TextColor" Value="{StaticResource Ink}" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="FontSize" Value="17" />
            </Style>
            <Style TargetType="Picker" ApplyToDerivedTypes="True">
                <Setter Property="TextColor" Value="{StaticResource Ink}" />
                <Setter Property="TitleColor" Value="{StaticResource MutedInk}" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="Margin" Value="10,0" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource Ink}" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="18,12" />
                <Setter Property="MinimumHeightRequest" Value="48" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="BorderColor" Value="#D2DCE8" />
                <Setter Property="BackgroundColor" Value="#EFF3F7" />
                <Setter Property="ContentLayout" Value="Left,12" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters><Setter Property="Opacity" Value="0.86" /></VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters><Setter Property="Opacity" Value="0.7" /></VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters><Setter Property="Opacity" Value="0.45" /></VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="BackgroundColor" Value="#FCFDFE" />
                <Setter Property="Stroke" Value="#E4EAF1" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 7" />
                <Setter Property="Padding" Value="20" />
            </Style>
            <Style x:Key="InputBorderStyle" TargetType="Border">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="Stroke" Value="#CCD6E2" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 6" />
            </Style>
            <Style x:Key="FieldLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
            <Style x:Key="TableHeaderStyle" TargetType="Label">
                <Setter Property="TextColor" Value="#263D59" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="LineBreakMode" Value="NoWrap" />
            </Style>
            <Style x:Key="TableCellStyle" TargetType="Label">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="LineBreakMode" Value="TailTruncation" />
                <Setter Property="MaxLines" Value="1" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
