<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>EvoOffer</RootNamespace>
    <NeutralLanguage>ro</NeutralLanguage>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="QuestPDF" Version="2026.9.0" />
    <Compile Include="../EvoOffer/Models/*.cs" Link="Models/%(Filename)%(Extension)" />
    <Compile Include="../EvoOffer/ViewModels/*.cs" Link="ViewModels/%(Filename)%(Extension)" />
    <Compile Include="../EvoOffer/Services/*.cs" Link="Services/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../EvoOffer/Resources/Strings/*.resx" Link="Resources/Strings/%(Filename)%(Extension)" />
    <Content Include="Fixtures/sample_logo.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
